# Copy to .env and fill in your Supabase project values.
# These are safe-to-expose client values (the anon key relies on RLS).
# Never put server secrets (e.g. AI provider API keys) in EXPO_PUBLIC_* vars —
# they are inlined into the shipped JS bundle. Server secrets belong in
# Supabase Edge Function secrets (see supabase/README.md).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
